# /etc/seren.env on the server. Names only; real values never enter the repo.
AWS_REGION=us-east-2
SEREN_HOST=127.0.0.1
SEREN_PORT=8790
# The corpus and campaigns. Private content: it lives here, never in the repo.
SEREN_CONTENT_DIR=/srv/seren
SEREN_CAMPAIGN=sheep-crazy
SEREN_PC=seren
# free | paid — which Nova model and which per-session spend cap
SEREN_TIER=paid
# The shared door password. Unset = no gate at all.
SEREN_PASSWORD=
# Pin this, or every restart signs everyone out.
SEREN_COOKIE_SECRET=
# Sign in with Google (unset = the password door only). The redirect is
# https://seren.unstuck-games.com/auth/google/callback
SEREN_GOOGLE_CLIENT_ID=
SEREN_GOOGLE_CLIENT_SECRET=
# Who may sign in with Google, comma-separated. Unset = any Google account.
SEREN_ALLOW=
# Pin this, or every restart signs every Google user out.
SEREN_SESSION_SECRET=
