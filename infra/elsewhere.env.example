# /etc/elsewhere.env on the server. Names only; real values never enter the repo.
AWS_REGION=us-east-2
ELSEWHERE_HOST=127.0.0.1
ELSEWHERE_PORT=8765
# The shared door password. Unset = no gate at all.
ELSEWHERE_PASSWORD=
# Pin this, or every restart signs everyone out.
ELSEWHERE_COOKIE_SECRET=
# The new account refuses plain amazon.nova-micro-v1:0 on demand; use the us. profile.
ELSEWHERE_INTERPRET_MODEL=us.amazon.nova-micro-v1:0
