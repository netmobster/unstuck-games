[Unit]
Description=The password door for playtest games that are only files (The Last Warren's /play/)
After=network-online.target

[Service]
User=ec2-user
# DOOR_PASSWORD and DOOR_SECRET, written by infra/unstuck-env.py from /unstuck/door/* in Parameter Store.
EnvironmentFile=/etc/door.env
ExecStart=/usr/bin/python3 -u /srv/unstuck/services/door.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
